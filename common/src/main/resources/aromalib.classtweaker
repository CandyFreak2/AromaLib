classTweaker v1 official

# Grant access to the package-private LINES snippet so the trail can render
# pipelines in BlockOutlineRenderer / PathTrailRenderer can extend it
# instead of redeclaring all shaders + uniforms + vertex format inline.
accessible field net/minecraft/client/renderer/RenderPipelines LINES_SNIPPET Lcom/mojang/blaze3d/pipeline/RenderPipeline$Snippet;

# Grant access to the package-private RenderType.create(String, RenderSetup)
# factory used by the trail BlockOutlineRenderer + PathTrailRenderer.
accessible method net/minecraft/client/renderer/rendertype/RenderType create (Ljava/lang/String;Lnet/minecraft/client/renderer/rendertype/RenderSetup;)Lnet/minecraft/client/renderer/rendertype/RenderType;